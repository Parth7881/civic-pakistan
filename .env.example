# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase Service Role (Server-side only)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# PostGIS Database Connection (Server-side only)
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# Google Maps (browser key; required for live maps)
# Restrict this key in Google Cloud by HTTP referrer and enable ONLY the
# "Maps JavaScript API". It is public by design - no server secret belongs here.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_browser_key_here

# Optional: path to a locally owned hero photograph in /public (see public/images/README.md).
# When unset, the original CivicPakistan skyline artwork is used.
NEXT_PUBLIC_HERO_IMAGE=

# Legacy AI provider key name (server-side only; OPENAI_API_KEY below is preferred)
AI_PROVIDER_API_KEY=your_ai_provider_key_here

# Application origin; also configure /auth/callback in Supabase Auth redirect URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Reporting: server-controlled only. Default live GPS limit is 100 m; may tighten to 1–100.
CIVIC_GPS_MAX_ACCURACY_METERS=100
# Explicit testing only; requires the additive reporting_location_policy migration.
# Uses a server-selected point inside the active demo area; never arbitrary coordinates.
CIVIC_DEMO_GEO_ENABLED=false
CIVIC_AI_EVIDENCE_ENABLED=false
CIVIC_EVIDENCE_MODEL=gpt-5.6-luna
OPENAI_API_KEY=your-server-only-openai-key
